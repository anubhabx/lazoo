{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": null
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Anubhab Debnath",
    "copyright": "Copyright Anubhab Debnath",
    "category": "DeveloperTool",
    "shortDescription": "A local control room for a team of native coding agents",
    "icon": ["icons/icon.ico"],
    "externalBin": [
      "binaries/lazood",
      "binaries/lazoo-keeper",
      "binaries/lazooctl",
      "binaries/lazoo-session-host"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
